{
  "name": "ccmonitor",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "bin": {
    "ccmonitor": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/ccmonitor",
    "install:global": "bun run scripts/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
